{
  "application": { "name": "VoxMind-GPU", "version": "1.0.0", "environment": "production" },
  "audio": { "default_sample_rate": 16000 },
  "api": { "port": 8090, "enable_swagger": true },
  "ml": {
    "vad": { "enabled": false },
    "transcription": {
      "engine": "parakeet",
      "parakeet_model_path": "/app/models/parakeet-tdt-0.6b-v3-int8",
      "default_model": "parakeet"
    },
    "speaker_recognition": {
      "enabled": false
    },
    "tts": {
      "enabled": true,
      "default_engine": "chatterbox",
      "default_language": "fr",
      "cache_capacity": 2,
      "chatterbox_languages": {
        "fr": {
          "language": "fr",
          "speech_encoder_model_path": "/app/models/chatterbox/speech_encoder.onnx",
          "embed_tokens_model_path": "/app/models/chatterbox/embed_tokens.onnx",
          "language_model_path": "/app/models/chatterbox/language_model_fp16.onnx",
          "conditional_decoder_model_path": "/app/models/chatterbox/conditional_decoder.onnx",
          "tokenizer_path": "/app/models/chatterbox/tokenizer.json",
          "default_reference_wav": "/app/models/chatterbox/fr/reference.wav",
          "default_reference_text": "Bonjour, je suis prête à vous parler.",
          "lm_variant": "fp16",
          "exaggeration": 1.3,
          "device": "cuda",
          "use_sampling": true
        }
      }
    }
  },
  "logging": {
    "level": "Information",
    "console": { "enabled": true, "format": "json" },
    "file": { "enabled": false }
  }
}
