<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VoxMind.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoxMind.Core\VoxMind.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" Version="1.12.32" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
  </ItemGroup>


  <!-- Force sherpa-onnx onnxruntime (1.23.2) to win over ML.OnnxRuntime : sherpa-onnx-c-api.so exige
       VERS_1.23.2, absent du libonnxruntime.so de Microsoft.ML.OnnxRuntime 1.22.0. -->
  <ItemGroup>
    <SherpaOnnxRuntimeLib Include="$(NuGetPackageRoot)org.k2fsa.sherpa.onnx.runtime.linux-x64\1.12.32\runtimes\linux-x64\native\libonnxruntime.so" />
  </ItemGroup>

  <!-- ...côté build (dotnet run / tests). -->
  <Target Name="CopySherpaOnnxRuntime" AfterTargets="Build">
    <Copy SourceFiles="@(SherpaOnnxRuntimeLib)"
          DestinationFolder="$(OutDir)runtimes\linux-x64\native\"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
  </Target>

  <!-- ...côté publish (image Docker) : le pipeline de publication redépose le libonnxruntime.so de
       ML.OnnxRuntime dans $(PublishDir) ; on le réécrase APRÈS par celui de sherpa (1.23.2). -->
  <Target Name="CopySherpaOnnxRuntimePublish" AfterTargets="Publish">
    <Copy SourceFiles="@(SherpaOnnxRuntimeLib)"
          DestinationFolder="$(PublishDir)runtimes\linux-x64\native\"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
  </Target>

</Project>
