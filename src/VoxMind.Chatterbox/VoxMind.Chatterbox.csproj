<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VoxMind.Chatterbox</AssemblyName>
    <RootNamespace>VoxMind.Chatterbox</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- ONNX Runtime 1.22.0 (requis : support q4 / MatMulNBits 4 bits).
       CPU par défaut ; build GPU (CUDAExecutionProvider) via -p:UseCuda=true.
       Un seul package managé doit être actif dans tout le graphe (cohérence d'assembly). -->
  <ItemGroup Condition="'$(UseCuda)' == 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.22.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCuda)' != 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
  </ItemGroup>
  <!-- Symbole CUDA : active l'appel AppendExecutionProvider_CUDA (cf. #if CUDA dans ChatterboxPipeline). -->
  <PropertyGroup Condition="'$(UseCuda)' == 'true'">
    <DefineConstants>$(DefineConstants);CUDA</DefineConstants>
  </PropertyGroup>

</Project>
