<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VoxMind.Core</AssemblyName>
    <RootNamespace>VoxMind.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base de données -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- Speaker Recognition — sherpa-onnx (C# pur, sans serveur Python) -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.12.32" />

    <!-- DI & Hosting -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />

    <!-- Audio (conditionnel par plateforme) -->
    <PackageReference Include="NAudio" Version="2.2.1" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.2" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />

    <!-- Décodage multi-formats (MP3, WAV, OGG, Opus, WebM) via FFmpeg CLI -->
    <PackageReference Include="FFMpegCore" Version="5.1.0" />

  </ItemGroup>

  <!-- ONNX Runtime 1.22.0 (CPU) — utilisé par F5-TTS et Parakeet. Un seul package managé
       dans tout le graphe pour éviter les conflits d'assembly. La synthèse vocale par défaut
       (Kokoro) passe par sherpa-onnx ; il n'y a plus de chemin GPU/CUDA. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
  </ItemGroup>

  <!-- Overrides de sécurité : forcent des versions corrigées sur des dépendances
       transitives vulnérables (NU1903) tirées par EF Core 10. -->
  <ItemGroup>
    <!-- EF Core Sqlite 10.0.0 → SQLitePCLRaw.bundle_e_sqlite3 2.1.11 (GHSA-2m69-gcr7-jv3q).
         Correctif uniquement en 3.0.x (embarque SQLite patché). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- EF Core Design → MSBuild → System.Security.Cryptography.Xml 9.0.0
         (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf). Corrigé en 10.0.x. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../VoxMind.Parakeet/VoxMind.Parakeet.csproj" />
    <ProjectReference Include="../VoxMind.F5Tts/VoxMind.F5Tts.csproj" />
  </ItemGroup>


</Project>
