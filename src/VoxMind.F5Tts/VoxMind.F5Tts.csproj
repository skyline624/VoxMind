<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VoxMind.F5Tts</AssemblyName>
    <RootNamespace>VoxMind.F5Tts</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- ONNX Runtime 1.22.0 : CPU par défaut ; .Gpu via -p:UseCuda=true. Doit rester aligné
       sur le reste du graphe (un seul package managé actif à la fois). -->
  <ItemGroup Condition="'$(UseCuda)' == 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.22.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCuda)' != 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
  </ItemGroup>
  <PropertyGroup Condition="'$(UseCuda)' == 'true'">
    <DefineConstants>$(DefineConstants);CUDA</DefineConstants>
  </PropertyGroup>

</Project>
