<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VoxMind.F5Tts</AssemblyName>
    <RootNamespace>VoxMind.F5Tts</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- ONNX Runtime 1.22.0 (CPU). Doit rester aligné sur le reste du graphe
       (un seul package managé actif à la fois). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
  </ItemGroup>

</Project>
